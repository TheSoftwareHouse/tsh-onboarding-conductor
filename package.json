{
  "name": "tsh-onboarding-conductor",
  "version": "0.1.0",
  "private": true,
  "description": "Onboarding Orchestrator Monorepo",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.cjs",
    "prepare": "husky",
    "changeset": "changeset",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "format": "pnpm -r --if-present run format",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "node scripts/test-e2e.cjs",
    "test:e2e:ci": "pnpm -r --if-present run test:e2e",
    "test:cov": "pnpm -r --if-present run test:cov",
    "stack:up": "node scripts/compose.cjs up -d --build",
    "stack:down": "node scripts/compose.cjs down --remove-orphans",
    "stack:ps": "node scripts/compose.cjs ps",
    "stack:logs": "node scripts/compose.cjs logs -f --tail=100",
    "stack:config": "node scripts/compose.cjs config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript": "^5.9.3",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint": "^8.42.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.5.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
