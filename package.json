{
  "name": "tsh-onboarding-conductor",
  "version": "0.2.0",
  "private": true,
  "description": "Onboarding Orchestrator Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSoftwareHouse/tsh-onboarding-conductor"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.cjs",
    "prepare": "husky",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "format": "pnpm -r --if-present run format",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm test:scripts",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "node scripts/test-e2e.cjs",
    "test:e2e:ci": "pnpm -r --if-present run test:e2e",
    "test:mailhog:integration": "node scripts/test-mailhog-integration.cjs",
    "test:cov": "pnpm -r --if-present run test:cov && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.cjs\"",
    "skills:validate": "node scripts/validate-skills.cjs",
    "skills:routing": "node scripts/test-skill-routing.cjs",
    "skills:ablation": "node scripts/test-skill-ablation.cjs",
    "skills:evals": "pnpm --filter @tsh/skill-evals run evals",
    "version:bump": "node scripts/version-bump.cjs",
    "changelog:check": "node scripts/check-changelog.cjs",
    "workflow:validate": "node scripts/validate-workflows.cjs",
    "workflow:compile": "pnpm --filter @tsh/ddl-schema build && node scripts/compile-workflow.cjs",
    "openapi:generate": "pnpm --filter @tsh/ddl-schema build && pnpm --filter @tsh/engine openapi:generate",
    "docs:dev": "pnpm --filter @tsh/ddl-schema build && pnpm --filter @tsh/docs start",
    "docs:build": "pnpm --filter @tsh/ddl-schema build && pnpm --filter @tsh/docs build",
    "stack:integration:up": "node scripts/compose.cjs stop engine-worker || true && node scripts/compose.cjs up -d --build --wait engine",
    "stack:up": "node scripts/compose.cjs up -d --build",
    "stack:panel-dev:up": "pnpm --filter @tsh/admin-panel build && node scripts/compose.cjs -f docker-compose.yml -f docker-compose.panel-dev.yml up -d engine engine-worker",
    "panel:watch": "pnpm --filter @tsh/admin-panel build:watch",
    "stack:down": "node scripts/compose.cjs --profile \"*\" down --remove-orphans",
    "stack:reset": "node scripts/compose.cjs --profile \"*\" down --remove-orphans --volumes",
    "stack:prune": "node scripts/stack-prune.cjs --all",
    "stack:ps": "node scripts/compose.cjs ps",
    "stack:logs": "node scripts/compose.cjs logs -f --tail=100",
    "stack:config": "node scripts/compose.cjs config"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "jest": "^29.5.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
