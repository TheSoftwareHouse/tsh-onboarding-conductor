{
  "name": "@tsh/onboarding-seeder",
  "version": "0.1.2",
  "private": true,
  "description": "Seeds a deterministic, manifest-described population of synthetic onboardings by driving the engine's public API.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "seed": "node -r ts-node/register/transpile-only src/cli.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config ./jest.config.cjs --passWithNoTests",
    "test:cov": "jest --config ./jest.config.cjs --coverage --passWithNoTests"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.23.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
