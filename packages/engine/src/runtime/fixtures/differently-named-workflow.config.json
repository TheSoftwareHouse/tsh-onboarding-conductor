{
  "id": "passport-check",
  "version": 3,
  "name": "Passport Check",
  "initial": "capture_alias",
  "steps": [
    {
      "name": "capture_alias",
      "status": "awaiting_user",
      "data": {
        "contactAddress": {
          "type": "string",
          "required": true,
          "validation": {
            "format": "email"
          }
        }
      },
      "transitions": [
        {
          "status": "success",
          "target": "confirm_identity"
        }
      ]
    },
    {
      "name": "confirm_identity",
      "status": "awaiting_user",
      "data": {
        "identityConfirmed": {
          "type": "boolean",
          "required": true,
          "validation": {
            "const": true
          }
        }
      },
      "transitions": [
        {
          "status": "success",
          "target": "cleared"
        }
      ]
    },
    {
      "name": "cleared",
      "status": "approved",
      "data": {},
      "transitions": []
    }
  ]
}
