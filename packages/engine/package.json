{
  "name": "@tsh/engine",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start:debug": "node --inspect-brk --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start:prod": "node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.cjs --runInBand",
    "test:smtp": "JEST_E2E_SPEC=smtp.e2e-spec.ts node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.cjs --runInBand",
    "test:e2e": "pnpm --filter @tsh/ddl-schema build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.cjs --runInBand",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "openapi:generate": "node -r ts-node/register src/openapi/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-presigned-post": "3.1090.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "@sendgrid/mail": "^8.1.6",
    "@tsh/ddl-schema": "workspace:*",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "file-type": "22.0.1",
    "image-size": "2.0.2",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "jose": "^5.10.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "typeorm": "^0.3.25",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
