{
  "name": "@tsh/ddl-schema",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./workflow-contract": {
      "types": "./dist/workflow-contract.d.ts",
      "require": "./dist/workflow-contract.js"
    },
    "./workflow-validator": {
      "types": "./dist/workflow-validator.d.ts",
      "require": "./dist/workflow-validator.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config ./jest.config.cjs --passWithNoTests",
    "test:cov": "jest --config ./jest.config.cjs --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1"
  }
}
