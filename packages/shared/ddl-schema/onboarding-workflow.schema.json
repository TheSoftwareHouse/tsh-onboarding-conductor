{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tsh.dev/schemas/onboarding-workflow.schema.json",
  "title": "Onboarding workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "initial": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "data", "transitions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["awaiting_user", "approved"] },
          "data": {
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": {
              "anyOf": [
                { "$ref": "#/definitions/textDescriptor" },
                { "$ref": "#/definitions/numberDescriptor" },
                { "$ref": "#/definitions/booleanDescriptor" },
                { "$ref": "#/definitions/dateDescriptor" }
              ]
            }
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "order", "fieldMapping"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "order": { "type": "integer", "minimum": 1 },
                "fieldMapping": {
                  "type": "object",
                  "propertyNames": { "minLength": 1 },
                  "additionalProperties": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "target"],
              "properties": {
                "status": { "const": "success" },
                "target": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "textDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "enum": ["text", "string"] },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 0 },
            "pattern": { "type": "string" },
            "format": { "enum": ["email", "phone", "credit-card", "account-number"] },
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "manyOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          },
          "not": {
            "type": "object",
            "properties": {
              "oneOf": {},
              "manyOf": {}
            },
            "required": ["oneOf", "manyOf"]
          }
        }
      }
    },
    "numberDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "number" },
        "persist": { "type": "boolean" },
        "required": { "type": "boolean" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "exclusiveMinimum": { "type": "number" },
            "exclusiveMaximum": { "type": "number" },
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "number" }
            },
            "manyOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "number" }
            }
          },
          "not": {
            "type": "object",
            "properties": {
              "oneOf": {},
              "manyOf": {}
            },
            "required": ["oneOf", "manyOf"]
          }
        }
      }
    },
    "booleanDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "boolean" },
        "persist": { "type": "boolean" },
        "required": { "type": "boolean" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "boolean" }
            }
          }
        }
      }
    },
    "dateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "date" },
        "persist": { "type": "boolean" },
        "required": { "type": "boolean" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oneOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "manyOf": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          },
          "not": {
            "type": "object",
            "properties": {
              "oneOf": {},
              "manyOf": {}
            },
            "required": ["oneOf", "manyOf"]
          }
        }
      }
    }
  }
}
