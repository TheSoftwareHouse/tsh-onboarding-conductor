{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tsh.dev/schemas/onboarding-workflow.schema.json",
  "title": "Onboarding workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "initial": { "type": "string", "minLength": 1 },
    "webhook": { "$ref": "#/definitions/rootWebhookDeclaration" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "data", "transitions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["awaiting_user", "awaiting_manual_review", "approved", "rejected", "invalid"]
          },
          "data": {
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": {
              "anyOf": [
                { "$ref": "#/definitions/textDescriptor" },
                { "$ref": "#/definitions/numberDescriptor" },
                { "$ref": "#/definitions/booleanDescriptor" },
                { "$ref": "#/definitions/dateDescriptor" },
                { "$ref": "#/definitions/fileDescriptor" },
                { "$ref": "#/definitions/objectDescriptor" },
                { "$ref": "#/definitions/arrayDescriptor" }
              ]
            }
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "order", "fieldMapping"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "canReject": { "type": "boolean" },
                "async": { "type": "boolean" },
                "order": { "type": "integer", "minimum": 1 },
                "fieldMapping": {
                  "type": "object",
                  "propertyNames": { "minLength": 1 },
                  "additionalProperties": { "type": "string", "minLength": 1 }
                },
                "config": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/definitions/jsonValue" }
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "enum": [
                    "success",
                    "rejected",
                    "manual.approve",
                    "manual.reject",
                    "manual.invalid"
                  ]
                },
                "target": { "type": "string", "minLength": 1 },
                "when": { "$ref": "#/definitions/condition" },
                "webhook": { "$ref": "#/definitions/transitionWebhookDeclaration" }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": { "enum": ["manual.approve", "manual.reject", "manual.invalid"] }
                    },
                    "required": ["status"]
                  },
                  "then": {
                    "properties": { "target": { "type": "string", "minLength": 1 } },
                    "required": ["target"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/jsonValue" }
    },
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/definitions/jsonValue" } },
        { "$ref": "#/definitions/jsonObject" }
      ]
    },
    "conditionScalar": { "type": ["string", "number", "boolean", "null"] },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/condition" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/condition" } },
        "not": { "$ref": "#/definitions/condition" },
        "field": { "type": "string", "minLength": 1 },
        "equals": { "$ref": "#/definitions/conditionScalar" },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/conditionScalar" }
        },
        "isSet": { "type": "boolean" }
      },
      "oneOf": [
        { "$ref": "#/definitions/conditionAll" },
        { "$ref": "#/definitions/conditionAny" },
        { "$ref": "#/definitions/conditionNot" },
        { "$ref": "#/definitions/conditionFieldComparison" }
      ]
    },
    "conditionAll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/condition" } }
      }
    },
    "conditionAny": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/condition" } }
      }
    },
    "conditionNot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not"],
      "properties": { "not": { "$ref": "#/definitions/condition" } }
    },
    "conditionFieldComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "$ref": "#/definitions/conditionScalar" },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/conditionScalar" }
        },
        "isSet": { "type": "boolean" }
      }
    },
    "rootWebhookDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notify"],
      "properties": { "notify": { "$ref": "#/definitions/notifyWebhookDeclaration" } }
    },
    "notifyWebhookDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "transitionWebhookDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notify"],
      "properties": { "notify": { "const": false } }
    },
    "textValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "format": { "enum": ["email", "account-number", "uuid", "uri", "phone"] },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "manyOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "not": {
        "type": "object",
        "properties": { "oneOf": {}, "manyOf": {} },
        "required": ["oneOf", "manyOf"]
      }
    },
    "numberValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number" }
        },
        "manyOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number" }
        }
      },
      "not": {
        "type": "object",
        "properties": { "oneOf": {}, "manyOf": {} },
        "required": ["oneOf", "manyOf"]
      }
    },
    "booleanValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "boolean" }
        }
      }
    },
    "dateValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "manyOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      },
      "not": {
        "type": "object",
        "properties": { "oneOf": {}, "manyOf": {} },
        "required": ["oneOf", "manyOf"]
      }
    },
    "arrayValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 }
      }
    },
    "textDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "enum": ["text", "string"] },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "validation": { "$ref": "#/definitions/textValidation" }
      }
    },
    "numberDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "number" },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "validation": { "$ref": "#/definitions/numberValidation" }
      }
    },
    "booleanDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "boolean" },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "validation": { "$ref": "#/definitions/booleanValidation" }
      }
    },
    "dateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "date" },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "validation": { "$ref": "#/definitions/dateValidation" }
      }
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "validation"],
      "properties": {
        "type": { "const": "file" },
        "required": { "type": "boolean", "const": true },
        "persist": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentTypes", "maxSizeBytes"],
          "properties": {
            "contentTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "maxSizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "maxImageWidth": { "type": "integer", "minimum": 1 },
            "maxImageHeight": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "objectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "fields"],
      "properties": {
        "type": { "const": "object" },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/definitions/nestedFieldDescriptor" }
        }
      }
    },
    "arrayDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "items"],
      "properties": {
        "type": { "const": "array" },
        "required": { "type": "boolean" },
        "persist": { "type": "boolean" },
        "items": { "$ref": "#/definitions/arrayItemDescriptor" },
        "validation": { "$ref": "#/definitions/arrayValidation" }
      }
    },
    "nestedTextDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "enum": ["text", "string"] },
        "required": { "type": "boolean" },
        "validation": { "$ref": "#/definitions/textValidation" }
      }
    },
    "nestedNumberDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "number" },
        "required": { "type": "boolean" },
        "validation": { "$ref": "#/definitions/numberValidation" }
      }
    },
    "nestedBooleanDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "boolean" },
        "required": { "type": "boolean" },
        "validation": { "$ref": "#/definitions/booleanValidation" }
      }
    },
    "nestedDateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "const": "date" },
        "required": { "type": "boolean" },
        "validation": { "$ref": "#/definitions/dateValidation" }
      }
    },
    "nestedObjectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "fields"],
      "properties": {
        "type": { "const": "object" },
        "required": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/definitions/nestedFieldDescriptor" }
        }
      }
    },
    "nestedArrayDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "items"],
      "properties": {
        "type": { "const": "array" },
        "required": { "type": "boolean" },
        "when": { "$ref": "#/definitions/condition" },
        "items": { "$ref": "#/definitions/arrayItemDescriptor" },
        "validation": { "$ref": "#/definitions/arrayValidation" }
      }
    },
    "nestedFieldDescriptor": {
      "anyOf": [
        { "$ref": "#/definitions/nestedTextDescriptor" },
        { "$ref": "#/definitions/nestedNumberDescriptor" },
        { "$ref": "#/definitions/nestedBooleanDescriptor" },
        { "$ref": "#/definitions/nestedDateDescriptor" },
        { "$ref": "#/definitions/nestedObjectDescriptor" },
        { "$ref": "#/definitions/nestedArrayDescriptor" }
      ]
    },
    "arrayItemTextDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "string"] },
        "validation": { "$ref": "#/definitions/textValidation" }
      }
    },
    "arrayItemNumberDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "number" },
        "validation": { "$ref": "#/definitions/numberValidation" }
      }
    },
    "arrayItemBooleanDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "boolean" },
        "validation": { "$ref": "#/definitions/booleanValidation" }
      }
    },
    "arrayItemDateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "date" },
        "validation": { "$ref": "#/definitions/dateValidation" }
      }
    },
    "arrayItemObjectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": {
        "type": { "const": "object" },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/definitions/nestedFieldDescriptor" }
        }
      }
    },
    "arrayItemArrayDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "array" },
        "items": { "$ref": "#/definitions/arrayItemDescriptor" },
        "validation": { "$ref": "#/definitions/arrayValidation" }
      }
    },
    "arrayItemDescriptor": {
      "anyOf": [
        { "$ref": "#/definitions/arrayItemTextDescriptor" },
        { "$ref": "#/definitions/arrayItemNumberDescriptor" },
        { "$ref": "#/definitions/arrayItemBooleanDescriptor" },
        { "$ref": "#/definitions/arrayItemDateDescriptor" },
        { "$ref": "#/definitions/arrayItemObjectDescriptor" },
        { "$ref": "#/definitions/arrayItemArrayDescriptor" }
      ]
    }
  }
}
