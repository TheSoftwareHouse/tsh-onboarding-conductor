{
  "name": "@tsh/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @tsh/ddl-schema build && rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config ./jest.config.cjs --passWithNoTests",
    "test:cov": "jest --config ./jest.config.cjs --coverage --passWithNoTests",
    "typecheck": "pnpm --filter @tsh/ddl-schema build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tsh/ddl-schema": "workspace:*"
  }
}
