{
  "name": "@tsh/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Onboarding Conductor documentation site: guides, API reference and workflow fixtures",
  "scripts": {
    "docusaurus": "docusaurus",
    "api:generate": "pnpm run api:clean && node scripts/copy-openapi.mjs && docusaurus gen-api-docs all && node scripts/label-info-page.mjs",
    "api:clean": "docusaurus clean-api-docs all",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:clean": "node scripts/generate-fixtures.mjs --clean",
    "start": "pnpm run api:generate && pnpm run fixtures:generate && docusaurus start --port 3030",
    "build": "pnpm run api:generate && pnpm run fixtures:generate && docusaurus build",
    "serve": "docusaurus serve --port 3030",
    "clear": "docusaurus clear",
    "typecheck": "pnpm run api:generate && tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"sidebars/**/*.ts\" \"scripts/**/*.mjs\" docusaurus.config.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "@tsh/ddl-schema": "workspace:*",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass": "^1.93.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
