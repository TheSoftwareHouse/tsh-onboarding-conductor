{
  "parameters": [
    {
      "name": "page",
      "required": false,
      "in": "query",
      "description": "The page to read, counted from 1.",
      "schema": { "minimum": 1, "default": 1, "type": "integer" }
    },
    {
      "name": "limit",
      "required": false,
      "in": "query",
      "description": "Rows per page.",
      "schema": { "minimum": 1, "maximum": 100, "default": 20, "type": "integer" }
    },
    {
      "name": "key",
      "required": false,
      "in": "query",
      "description": "Only versions of this family.",
      "schema": {
        "maxLength": 100,
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "example": "eu-b2c-terms",
        "type": "string"
      }
    },
    {
      "name": "type",
      "required": false,
      "in": "query",
      "description": "Only families of this type.",
      "schema": {
        "type": "string",
        "enum": ["terms_and_conditions", "privacy_notice"],
        "description": "What an agreement family is: terms, or a privacy notice. A property of the family rather than of one version, so every version published under one `key` classifies the same way.",
        "title": "AgreementType"
      }
    }
  ]
}
