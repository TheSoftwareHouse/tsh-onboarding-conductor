{
  "responses": {
    "200": {
      "description": "The current state and, unless terminal, the step to render.",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "onboardingId": { "type": "string", "format": "uuid" },
              "workflowId": { "type": "string" },
              "workflowVersion": { "type": "integer", "minimum": 1 },
              "status": {
                "description": "Where an onboarding stands. `awaiting_user` and `awaiting_manual_review` are live; `approved`, `rejected` and `invalid` are terminal.",
                "allOf": [
                  {
                    "type": "string",
                    "enum": [
                      "awaiting_user",
                      "awaiting_manual_review",
                      "approved",
                      "rejected",
                      "invalid"
                    ],
                    "description": "Where an onboarding stands. `awaiting_user` and `awaiting_manual_review` are live; `approved`, `rejected` and `invalid` are terminal.",
                    "title": "WorkflowStatus"
                  }
                ]
              },
              "currentStep": {
                "type": ["string", "null"],
                "description": "The step awaiting data; null once the onboarding is terminal."
              },
              "terminal": {
                "type": "boolean",
                "description": "True once the onboarding sits in a terminal step; `step` is then null."
              },
              "rejectionReason": {
                "description": "Why a connector refused, when a rejection a connector drove ended the onboarding.",
                "oneOf": [
                  {
                    "allOf": [
                      {
                        "type": "string",
                        "enum": [
                          "ATTEMPTS_EXHAUSTED",
                          "CHALLENGE_EXPIRED",
                          "CHALLENGE_NOT_FOUND",
                          "CONNECTOR_REJECTED"
                        ],
                        "description": "Why a connector refused the step's data: the caller exhausted its attempts, the challenge expired or was never issued, or the provider rejected outright.",
                        "title": "ConnectorRejectionReason"
                      }
                    ]
                  },
                  { "type": "null" }
                ]
              },
              "step": {
                "description": "The step to render, resolved against the persisted data; null when terminal.",
                "oneOf": [
                  {
                    "type": "object",
                    "allOf": [
                      {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "status": {
                            "description": "Where an onboarding stands. `awaiting_user` and `awaiting_manual_review` are live; `approved`, `rejected` and `invalid` are terminal.",
                            "allOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "awaiting_user",
                                  "awaiting_manual_review",
                                  "approved",
                                  "rejected",
                                  "invalid"
                                ],
                                "description": "Where an onboarding stands. `awaiting_user` and `awaiting_manual_review` are live; `approved`, `rejected` and `invalid` are terminal.",
                                "title": "WorkflowStatus"
                              }
                            ]
                          },
                          "canSubmit": {
                            "type": "boolean",
                            "description": "Whether the step declares a success transition, so a submit can ever be applied."
                          },
                          "fields": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": { "type": "string" },
                                "type": {
                                  "type": "string",
                                  "description": "The field type, as registered in the field-type registry (`text`, `file`, ...)."
                                },
                                "required": { "type": "boolean" },
                                "active": {
                                  "type": "boolean",
                                  "description": "Whether the field applies given the data persisted so far. `when` lets a client re-resolve this as the form fills."
                                },
                                "dependsOn": {
                                  "description": "Fields whose values this field's `when` condition reads.",
                                  "type": "array",
                                  "items": { "type": "string" }
                                },
                                "schema": {
                                  "type": "object",
                                  "additionalProperties": true,
                                  "description": "JSON Schema for this field's value."
                                },
                                "value": {
                                  "allOf": [
                                    {
                                      "description": "Any JSON value: an object, an array, a string, a number, a boolean or null.",
                                      "title": "JsonValue"
                                    }
                                  ],
                                  "description": "Persisted value for prefill, or null when the step has not accepted the field yet."
                                },
                                "when": {
                                  "allOf": [
                                    {
                                      "description": "A condition in normalized form: a combinator over other conditions, a comparison of a score, or a test of a submitted field.",
                                      "oneOf": [
                                        {
                                          "type": "object",
                                          "required": ["all"],
                                          "properties": {
                                            "all": {
                                              "type": "array",
                                              "items": "circular(WorkflowCondition)"
                                            }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["any"],
                                          "properties": {
                                            "any": {
                                              "type": "array",
                                              "items": "circular(WorkflowCondition)"
                                            }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["not"],
                                          "properties": { "not": "circular(WorkflowCondition)" }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["score", "gte"],
                                          "properties": {
                                            "score": { "type": "string" },
                                            "gte": { "type": "number" }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["score", "gt"],
                                          "properties": {
                                            "score": { "type": "string" },
                                            "gt": { "type": "number" }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["score", "lte"],
                                          "properties": {
                                            "score": { "type": "string" },
                                            "lte": { "type": "number" }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["score", "lt"],
                                          "properties": {
                                            "score": { "type": "string" },
                                            "lt": { "type": "number" }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["field", "equals"],
                                          "properties": {
                                            "field": { "type": "string" },
                                            "equals": {
                                              "oneOf": [
                                                { "type": "string" },
                                                { "type": "number" },
                                                { "type": "boolean" },
                                                { "type": "null" }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["field", "in"],
                                          "properties": {
                                            "field": { "type": "string" },
                                            "in": {
                                              "type": "array",
                                              "items": {
                                                "oneOf": [
                                                  { "type": "string" },
                                                  { "type": "number" },
                                                  { "type": "boolean" },
                                                  { "type": "null" }
                                                ]
                                              }
                                            }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": ["field", "isSet"],
                                          "properties": {
                                            "field": { "type": "string" },
                                            "isSet": { "type": "boolean" }
                                          }
                                        }
                                      ],
                                      "title": "WorkflowCondition"
                                    }
                                  ],
                                  "description": "The condition that decides `active`; absent for a field that always applies."
                                },
                                "upload": {
                                  "description": "Present for an upload field: what the document upload routes will accept for it.",
                                  "allOf": [
                                    {
                                      "type": "object",
                                      "properties": {
                                        "contentTypes": {
                                          "description": "MIME types the field accepts.",
                                          "type": "array",
                                          "items": { "type": "string" }
                                        },
                                        "maxSizeBytes": { "type": "integer" },
                                        "maxImageWidth": {
                                          "type": "integer",
                                          "description": "Present for image fields that bound width."
                                        },
                                        "maxImageHeight": {
                                          "type": "integer",
                                          "description": "Present for image fields that bound height."
                                        }
                                      },
                                      "required": ["contentTypes", "maxSizeBytes"],
                                      "title": "StepFieldUploadDescriptionResponseDto"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "name",
                                "type",
                                "required",
                                "active",
                                "dependsOn",
                                "schema",
                                "value"
                              ],
                              "title": "StepFieldDescriptionResponseDto"
                            }
                          },
                          "schema": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "JSON Schema of the submit body for the currently active fields; identical to what submit enforces."
                          }
                        },
                        "required": ["name", "status", "canSubmit", "fields", "schema"],
                        "title": "StepDescriptionResponseDto"
                      }
                    ]
                  },
                  { "type": "null" }
                ]
              }
            },
            "required": [
              "onboardingId",
              "workflowId",
              "workflowVersion",
              "status",
              "currentStep",
              "terminal",
              "rejectionReason",
              "step"
            ],
            "title": "OnboardingStateResponseDto"
          }
        }
      }
    },
    "404": {
      "description": "`ONBOARDING_NOT_FOUND`: No onboarding has this id.\n\n`WORKFLOW_NOT_FOUND`: No published workflow has this id, or no revision of it carries the pinned version.",
      "content": {
        "application/json": {
          "schema": {
            "allOf": [
              {
                "type": "object",
                "description": "The engine's own error envelope. `code` is the stable identifier a client branches on; `message` repeats it. A code that adds detail properties is described on the operation that returns it.",
                "required": ["code", "message"],
                "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
                "additionalProperties": true,
                "title": "ApiError"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": ["ONBOARDING_NOT_FOUND", "WORKFLOW_NOT_FOUND"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "410": {
      "description": "`WORKFLOW_RETIRED`: The pinned revision is retired and can no longer be read or run.",
      "content": {
        "application/json": {
          "schema": {
            "allOf": [
              {
                "type": "object",
                "description": "The engine's own error envelope. `code` is the stable identifier a client branches on; `message` repeats it. A code that adds detail properties is described on the operation that returns it.",
                "required": ["code", "message"],
                "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
                "additionalProperties": true,
                "title": "ApiError"
              },
              {
                "type": "object",
                "properties": { "code": { "type": "string", "enum": ["WORKFLOW_RETIRED"] } }
              }
            ]
          }
        }
      }
    }
  }
}
