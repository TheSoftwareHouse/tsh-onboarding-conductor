{
  "responses": {
    "200": {
      "description": "The acceptance, with when it was first recorded.",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "onboardingId": { "type": "string", "format": "uuid" },
              "agreementId": {
                "type": "string",
                "format": "uuid",
                "description": "The published version accepted."
              },
              "key": {
                "type": "string",
                "description": "The family of the accepted version.",
                "example": "eu-b2c-terms"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "description": "The accepted version."
              },
              "acceptedAt": {
                "type": ["string", "null"],
                "format": "date-time",
                "description": "When the version was first accepted; a repeated acceptance reports the original time."
              }
            },
            "required": ["onboardingId", "agreementId", "key", "version", "acceptedAt"],
            "title": "AcceptAgreementResponseDto"
          }
        }
      }
    },
    "404": {
      "description": "`ONBOARDING_NOT_FOUND`: No onboarding has this id.\n\n`AGREEMENT_NOT_FOUND`: No published version has this id, or the onboarding does not hold it: the pair must already be linked by a start, a submit, a publish or an operator's link.",
      "content": {
        "application/json": {
          "schema": {
            "allOf": [
              {
                "type": "object",
                "description": "The engine's own error envelope. `code` is the stable identifier a client branches on; `message` repeats it. A code that adds detail properties is described on the operation that returns it.",
                "required": ["code", "message"],
                "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
                "additionalProperties": true,
                "title": "ApiError"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": ["ONBOARDING_NOT_FOUND", "AGREEMENT_NOT_FOUND"]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
