{
  "id": "manual-review-typed",
  "version": 1,
  "initial": "awaiting_manual_review",
  "webhook": { "notify": { "path": "notify" } },
  "steps": [
    {
      "name": "awaiting_manual_review",
      "type": "manual-review",
      "include": [
        {
          "type": "form",
          "config": {
            "fields": {
              "reviewNotes": {
                "type": "text",
                "required": true,
                "validation": { "maxLength": 1000 }
              }
            }
          }
        }
      ],
      "edges": { "approve": "approved", "reject": "rejected", "invalid": "invalid" }
    },
    { "name": "approved", "type": "terminal", "config": { "outcome": "approved" } },
    { "name": "rejected", "type": "terminal", "config": { "outcome": "rejected" } },
    { "name": "invalid", "type": "terminal", "config": { "outcome": "invalid" } }
  ]
}
