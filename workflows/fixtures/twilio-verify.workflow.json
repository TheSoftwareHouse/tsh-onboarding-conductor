{
  "id": "twilio-verify",
  "version": 1,
  "name": "Twilio Verify",
  "initial": "request_code",
  "steps": [
    {
      "name": "request_code",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "phoneNumber": {
            "type": "text",
            "required": true,
            "validation": {
              "format": "phone"
            }
          }
        },
        "connectors": [
          {
            "name": "twilio_verify",
            "id": "twilio_verify",
            "type": "phone_verification",
            "order": 1,
            "fieldMapping": {
              "recipient": "phoneNumber"
            },
            "config": {
              "operation": "startVerification"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "verify_code"
          }
        ]
      }
    },
    {
      "name": "verify_code",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "verificationCode": {
            "type": "text",
            "required": true,
            "persist": false,
            "validation": {
              "minLength": 1
            }
          }
        },
        "connectors": [
          {
            "name": "twilio_verify",
            "id": "twilio_verify",
            "type": "phone_verification",
            "canReject": true,
            "order": 1,
            "fieldMapping": {
              "recipient": "phoneNumber",
              "code": "verificationCode"
            },
            "config": {
              "operation": "checkVerification"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "approved"
          },
          {
            "status": "rejected",
            "target": "rejected"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    },
    {
      "name": "rejected",
      "type": "custom",
      "config": {
        "status": "rejected",
        "data": {},
        "transitions": []
      }
    }
  ]
}
