{
  "id": "base",
  "version": 1,
  "name": "Base",
  "initial": "collect_email",
  "webhook": {
    "notify": {
      "path": "notify"
    }
  },
  "steps": [
    {
      "name": "collect_email",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "email": {
            "type": "text",
            "required": true,
            "validation": {
              "format": "email"
            }
          }
        },
        "connectors": [
          {
            "name": "mock_kyc_1",
            "id": "mock_kyc_1",
            "type": "kyc",
            "order": 1,
            "fieldMapping": {
              "email": "email"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "accept_terms",
            "webhook": {
              "notify": false
            }
          }
        ]
      }
    },
    {
      "name": "accept_terms",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "acceptedTerms": {
            "type": "boolean",
            "required": true,
            "validation": {
              "oneOf": [true]
            }
          }
        },
        "connectors": [
          {
            "name": "mock_kyc_1",
            "id": "mock_kyc_1",
            "type": "kyc",
            "order": 1,
            "fieldMapping": {
              "email": "email"
            }
          },
          {
            "name": "mock_kyc_2",
            "id": "mock_kyc_2",
            "type": "kyc",
            "order": 2,
            "fieldMapping": {
              "email": "email",
              "acceptedTerms": "acceptedTerms"
            }
          }
        ],
        "agreements": [{ "key": "base-terms", "acceptedWhen": "acceptedTerms" }],
        "transitions": [
          {
            "status": "success",
            "target": "approved"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    }
  ]
}
