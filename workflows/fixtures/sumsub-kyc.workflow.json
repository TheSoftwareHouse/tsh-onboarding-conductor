{
  "id": "sumsub-kyc",
  "version": 1,
  "name": "Sumsub KYC",
  "initial": "capture_identity",
  "steps": [
    {
      "name": "capture_identity",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "firstName": {
            "type": "text",
            "required": true
          },
          "lastName": {
            "type": "text",
            "required": true
          },
          "dateOfBirth": {
            "type": "date",
            "required": true
          },
          "nationality": {
            "type": "text",
            "required": true,
            "validation": {
              "pattern": "^[A-Z]{2}$"
            }
          },
          "country": {
            "type": "text",
            "required": true,
            "validation": {
              "pattern": "^[A-Z]{2}$"
            }
          },
          "street": {
            "type": "text",
            "required": true
          },
          "town": {
            "type": "text",
            "required": true
          },
          "postCode": {
            "type": "text",
            "required": true
          },
          "accountPurpose": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": [
                "salary",
                "personal_spending",
                "savings",
                "marketplace_payouts",
                "travel",
                "remittance",
                "other"
              ]
            }
          },
          "employmentStatus": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": ["employed", "self_employed", "student", "retired", "unemployed", "other"]
            }
          },
          "occupationGroup": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": [
                "isco_1",
                "isco_2",
                "isco_3",
                "isco_4",
                "isco_5",
                "isco_6",
                "isco_7",
                "isco_8",
                "isco_9",
                "isco_0",
                "not_in_workforce",
                "other"
              ]
            }
          },
          "occupationTitle": {
            "type": "text",
            "required": true
          },
          "sourceOfFunds": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": [
                "salary",
                "savings",
                "pension",
                "benefits",
                "investments",
                "sale_of_asset",
                "family_support",
                "other"
              ]
            }
          },
          "monthlyIncomingBand": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": ["lt_1k", "1k_5k", "5k_15k", "15k_50k", "gt_50k"]
            }
          },
          "monthlyOutgoingBand": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": ["lt_1k", "1k_5k", "5k_15k", "15k_50k", "gt_50k"]
            }
          },
          "pepSelfDeclared": {
            "type": "boolean",
            "required": true
          },
          "identityDocument": {
            "type": "file",
            "required": true,
            "validation": {
              "contentTypes": ["image/png", "image/jpeg", "application/pdf"],
              "maxSizeBytes": 10485760
            }
          }
        },
        "transitions": [
          {
            "status": "success",
            "target": "capture_identity_back"
          }
        ]
      }
    },
    {
      "name": "capture_identity_back",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "identityDocumentBack": {
            "type": "file",
            "required": true,
            "validation": {
              "contentTypes": ["image/png", "image/jpeg", "application/pdf"],
              "maxSizeBytes": 10485760
            }
          }
        },
        "transitions": [
          {
            "status": "success",
            "target": "capture_selfie"
          }
        ]
      }
    },
    {
      "name": "capture_selfie",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "selfieDocument": {
            "type": "file",
            "required": true,
            "validation": {
              "contentTypes": ["image/png", "image/jpeg"],
              "maxSizeBytes": 10485760
            }
          }
        },
        "transitions": [
          {
            "status": "success",
            "target": "submit_kyc"
          }
        ]
      }
    },
    {
      "name": "submit_kyc",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "kycOutcome": {
            "type": "text",
            "required": false,
            "validation": {
              "oneOf": ["verified", "human_review", "retry", "refused"]
            }
          },
          "kycRetryStep": {
            "type": "text",
            "required": false,
            "when": {
              "field": "kycOutcome",
              "equals": "retry"
            },
            "validation": {
              "oneOf": ["IDENTITY", "SELFIE", "APPLICANT_DATA", "QUESTIONNAIRE"]
            }
          },
          "kycReasonCodes": {
            "type": "array",
            "required": false,
            "items": {
              "type": "text"
            }
          },
          "kycCustomerMessage": {
            "type": "text",
            "required": false
          }
        },
        "connectors": [
          {
            "name": "sumsub_kyc",
            "id": "sumsub_kyc",
            "type": "kyc",
            "async": true,
            "order": 1,
            "fieldMapping": {
              "firstName": "firstName",
              "lastName": "lastName",
              "dateOfBirth": "dateOfBirth",
              "nationality": "nationality",
              "country": "country",
              "street": "street",
              "town": "town",
              "postCode": "postCode",
              "accountPurpose": "accountPurpose",
              "employmentStatus": "employmentStatus",
              "occupationGroup": "occupationGroup",
              "occupationTitle": "occupationTitle",
              "sourceOfFunds": "sourceOfFunds",
              "monthlyIncomingBand": "monthlyIncomingBand",
              "monthlyOutgoingBand": "monthlyOutgoingBand",
              "pepSelfDeclared": "pepSelfDeclared",
              "identityDocumentId": "identityDocument",
              "identityDocumentBackId": "identityDocumentBack",
              "selfieDocumentId": "selfieDocument"
            },
            "config": {
              "levelName": "individual-standard-v2",
              "sourceKey": "sumsub_kyc_individual_standard_v2",
              "questionnaireDefinitionId": "purpose_profile_v2",
              "documents": [
                {
                  "payloadField": "identityDocumentId",
                  "idDocSetType": "IDENTITY",
                  "idDocType": "ID_CARD",
                  "country": "POL",
                  "idDocSubType": "FRONT_SIDE"
                },
                {
                  "payloadField": "identityDocumentBackId",
                  "idDocSetType": "IDENTITY",
                  "idDocType": "ID_CARD",
                  "idDocSubType": "BACK_SIDE",
                  "country": "POL"
                },
                {
                  "payloadField": "selfieDocumentId",
                  "idDocSetType": "SELFIE",
                  "idDocType": "SELFIE",
                  "country": "POL"
                }
              ],
              "questionnairePathMap": {
                "accountPurpose": "purpose.account_purpose",
                "employmentStatus": "employment.employment_status",
                "occupationGroup": "employment.occupation_group",
                "occupationTitle": "employment.occupation_title",
                "sourceOfFunds": "funds.source_of_funds",
                "monthlyIncomingBand": "funds.monthly_in_band",
                "monthlyOutgoingBand": "funds.monthly_out_band",
                "pepSelfDeclared": "declarations.pep_self_declared"
              },
              "maxAttemptsPerDocSet": 3
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "when": {
              "field": "kycOutcome",
              "equals": "verified"
            },
            "target": "approved"
          },
          {
            "status": "success",
            "when": {
              "field": "kycOutcome",
              "equals": "human_review"
            },
            "target": "manual_review"
          },
          {
            "status": "success",
            "when": {
              "all": [
                {
                  "field": "kycOutcome",
                  "equals": "retry"
                },
                {
                  "field": "kycRetryStep",
                  "in": ["IDENTITY", "APPLICANT_DATA", "QUESTIONNAIRE"]
                }
              ]
            },
            "target": "capture_identity"
          },
          {
            "status": "success",
            "when": {
              "all": [
                {
                  "field": "kycOutcome",
                  "equals": "retry"
                },
                {
                  "field": "kycRetryStep",
                  "equals": "SELFIE"
                }
              ]
            },
            "target": "capture_selfie"
          },
          {
            "status": "success",
            "target": "rejected"
          }
        ]
      }
    },
    {
      "name": "manual_review",
      "type": "custom",
      "config": {
        "status": "awaiting_manual_review",
        "data": {},
        "transitions": [
          {
            "status": "manual.approve",
            "target": "approved"
          },
          {
            "status": "manual.reject",
            "target": "rejected"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    },
    {
      "name": "rejected",
      "type": "custom",
      "config": {
        "status": "rejected",
        "data": {},
        "transitions": []
      }
    }
  ]
}
