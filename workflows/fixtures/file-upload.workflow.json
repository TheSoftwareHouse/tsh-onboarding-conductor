{
  "id": "file-upload",
  "version": 1,
  "initial": "collect_identity",
  "steps": [
    {
      "name": "collect_identity",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "identityDocument": {
            "type": "file",
            "required": true,
            "validation": {
              "contentTypes": ["image/png", "image/jpeg"],
              "maxSizeBytes": 5242880,
              "maxImageWidth": 4096,
              "maxImageHeight": 4096
            }
          },
          "documentLabel": {
            "type": "text",
            "required": true,
            "validation": {
              "minLength": 1
            }
          }
        },
        "connectors": [
          {
            "name": "mock_sumsub_file_upload",
            "id": "mock_sumsub_file_upload",
            "type": "kyc",
            "order": 1,
            "fieldMapping": {
              "documentId": "identityDocument"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "approved"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    }
  ]
}
