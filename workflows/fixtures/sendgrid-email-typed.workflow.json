{
  "id": "sendgrid-email-typed",
  "version": 1,
  "name": "SendGrid Email (specialized steps)",
  "initial": "send_email",
  "steps": [
    {
      "name": "send_email",
      "type": "notify",
      "config": {
        "connector": {
          "id": "sendgrid_email",
          "fieldMapping": {
            "templateId": "emailTemplateId",
            "dynamicTemplateData.first_name": "firstName",
            "dynamicTemplateData.account_reference": "accountReference",
            "dynamicTemplateData.company_name": "companyName"
          }
        },
        "recipientField": "email"
      },
      "include": [
        {
          "type": "form",
          "config": {
            "fields": {
              "email": { "type": "text", "required": true, "validation": { "format": "email" } },
              "emailTemplateId": {
                "type": "text",
                "required": true,
                "validation": { "pattern": "^d-" }
              },
              "firstName": { "type": "text", "required": true },
              "accountReference": { "type": "text", "required": true },
              "companyName": { "type": "text", "required": true }
            }
          }
        }
      ],
      "edges": { "success": "approved" }
    },
    { "name": "approved", "type": "terminal", "config": { "outcome": "approved" } }
  ]
}
