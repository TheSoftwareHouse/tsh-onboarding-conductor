{
  "id": "otp-sms",
  "version": 1,
  "name": "OTP by SMS",
  "initial": "request_code",
  "steps": [
    {
      "name": "request_code",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "phoneNumber": {
            "type": "text",
            "required": true,
            "validation": {
              "format": "phone"
            }
          }
        },
        "connectors": [
          {
            "name": "otp",
            "id": "otp",
            "type": "otp_verification",
            "order": 1,
            "fieldMapping": {
              "recipient": "phoneNumber"
            },
            "config": {
              "operation": "send",
              "channel": "sms"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "verify_code"
          }
        ]
      }
    },
    {
      "name": "verify_code",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "verificationCode": {
            "type": "text",
            "required": true,
            "persist": false,
            "validation": {
              "minLength": 1
            }
          }
        },
        "connectors": [
          {
            "name": "otp",
            "id": "otp",
            "type": "otp_verification",
            "canReject": true,
            "order": 1,
            "fieldMapping": {
              "recipient": "phoneNumber",
              "code": "verificationCode"
            },
            "config": {
              "operation": "check",
              "channel": "sms"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "approved"
          },
          {
            "status": "rejected",
            "target": "rejected"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    },
    {
      "name": "rejected",
      "type": "custom",
      "config": {
        "status": "rejected",
        "data": {},
        "transitions": []
      }
    }
  ]
}
