{
  "id": "file-upload-typed",
  "version": 1,
  "name": "File Upload (specialized steps)",
  "initial": "collect_identity",
  "steps": [
    {
      "name": "collect_identity",
      "type": "connector-call",
      "config": {
        "fields": {
          "identityDocument": {
            "type": "file",
            "required": true,
            "validation": {
              "contentTypes": ["image/png", "image/jpeg"],
              "maxSizeBytes": 5242880,
              "maxImageWidth": 4096,
              "maxImageHeight": 4096
            }
          },
          "documentLabel": { "type": "text", "required": true, "validation": { "minLength": 1 } }
        },
        "connectors": [
          {
            "name": "mock_sumsub_file_upload",
            "id": "mock_sumsub_file_upload",
            "type": "kyc",
            "order": 1,
            "fieldMapping": { "documentId": "identityDocument" }
          }
        ]
      },
      "edges": { "success": "approved" }
    },
    { "name": "approved", "type": "terminal", "config": { "outcome": "approved" } }
  ]
}
