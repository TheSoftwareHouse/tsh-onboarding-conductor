{
  "id": "otp-email-typed",
  "version": 1,
  "name": "OTP by email (specialized steps)",
  "initial": "request_code",
  "steps": [
    {
      "name": "request_code",
      "type": "otp-verify",
      "substeps": { "verify": "verify_code" },
      "config": {
        "channel": "email",
        "connector": { "id": "otp" }
      },
      "include": [{ "type": "contact-details", "config": { "phoneNumber": "omitted" } }],
      "edges": { "verified": "approved", "refused": "rejected" }
    },
    { "name": "approved", "type": "terminal", "config": { "outcome": "approved" } },
    { "name": "rejected", "type": "terminal", "config": { "outcome": "rejected" } }
  ]
}
