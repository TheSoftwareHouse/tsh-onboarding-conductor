{
  "id": "manual-smtp",
  "version": 1,
  "name": "Manual SMTP",
  "initial": "collect_message",
  "steps": [
    {
      "name": "collect_message",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "recipient": {
            "type": "text",
            "required": true,
            "validation": {
              "format": "email"
            }
          },
          "subject": {
            "type": "text",
            "required": true,
            "validation": {
              "minLength": 1,
              "maxLength": 998
            }
          },
          "firstName": {
            "type": "text",
            "required": true,
            "validation": {
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "connectors": [
          {
            "name": "manual_smtp",
            "id": "smtp",
            "type": "email_delivery",
            "order": 1,
            "fieldMapping": {
              "recipient": "recipient",
              "subject": "subject",
              "firstName": "firstName"
            },
            "config": {
              "templatePath": "fixtures/manual-smtp.html"
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "approved"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    }
  ]
}
