{
  "id": "http-request",
  "version": 1,
  "initial": "register_customer",
  "steps": [
    {
      "name": "register_customer",
      "type": "custom",
      "config": {
        "status": "awaiting_user",
        "data": {
          "email": {
            "type": "text",
            "required": true,
            "validation": {
              "format": "email"
            }
          },
          "age": {
            "type": "number",
            "required": true,
            "validation": {
              "minimum": 18
            }
          }
        },
        "connectors": [
          {
            "name": "customer_registration",
            "id": "http_request",
            "type": "custom",
            "order": 1,
            "fieldMapping": {
              "customerEmail": "email",
              "customerAge": "age"
            },
            "config": {
              "request": {
                "method": "POST",
                "url": "https://api.example.com/v1/customers",
                "headers": {
                  "X-Api-Version": "2026-01-01"
                },
                "query": {
                  "onboarding": "{{execution.onboardingId}}",
                  "locale": "en"
                },
                "body": {
                  "email": "{{payload.customerEmail}}",
                  "age": "{{payload.customerAge}}",
                  "source": {
                    "step": "{{execution.stepName}}"
                  }
                },
                "timeoutMs": 5000
              },
              "response": {
                "errorsPath": "errors",
                "errorStatuses": [401, 403, 404]
              }
            }
          }
        ],
        "transitions": [
          {
            "status": "success",
            "target": "approved"
          }
        ]
      }
    },
    {
      "name": "approved",
      "type": "custom",
      "config": {
        "status": "approved",
        "data": {},
        "transitions": []
      }
    }
  ]
}
