{
  "id": "base-typed",
  "version": 1,
  "name": "Base (specialized steps)",
  "initial": "collect_email",
  "webhook": { "notify": { "path": "notify" } },
  "steps": [
    {
      "name": "collect_email",
      "type": "connector-call",
      "config": {
        "connectors": [
          {
            "name": "mock_kyc_1",
            "id": "mock_kyc_1",
            "type": "kyc",
            "order": 1,
            "fieldMapping": { "email": "email" }
          }
        ]
      },
      "include": [{ "type": "contact-details", "config": { "phoneNumber": "omitted" } }],
      "edges": { "success": [{ "target": "accept_terms", "webhook": { "notify": false } }] }
    },
    {
      "name": "accept_terms",
      "type": "connector-call",
      "agreements": [{ "key": "base-terms", "acceptedWhen": "acceptedTerms" }],
      "config": {
        "fields": {
          "acceptedTerms": {
            "type": "boolean",
            "required": true,
            "validation": { "oneOf": [true] }
          }
        },
        "connectors": [
          {
            "name": "mock_kyc_1",
            "id": "mock_kyc_1",
            "type": "kyc",
            "order": 1,
            "fieldMapping": { "email": "email" }
          },
          {
            "name": "mock_kyc_2",
            "id": "mock_kyc_2",
            "type": "kyc",
            "order": 2,
            "fieldMapping": { "email": "email", "acceptedTerms": "acceptedTerms" }
          }
        ]
      },
      "edges": { "success": "approved" }
    },
    { "name": "approved", "type": "terminal", "config": { "outcome": "approved" } }
  ]
}
