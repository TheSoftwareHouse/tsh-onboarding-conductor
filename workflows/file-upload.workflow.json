{
  "id": "file-upload",
  "version": 1,
  "name": "File Upload",
  "initial": "collect_identity",
  "steps": [
    {
      "name": "collect_identity",
      "status": "awaiting_user",
      "data": {
        "identityDocument": {
          "type": "file",
          "required": true,
          "validation": {
            "contentTypes": ["image/png", "image/jpeg"],
            "maxSizeBytes": 5242880,
            "maxImageWidth": 4096,
            "maxImageHeight": 4096
          }
        },
        "documentLabel": {
          "type": "text",
          "required": true,
          "validation": {
            "minLength": 1
          }
        }
      },
      "connectors": [
        {
          "name": "mock_sumsub_file_upload",
          "type": "mock_sumsub_file_upload",
          "order": 1,
          "fieldMapping": {
            "documentId": "identityDocument"
          }
        }
      ],
      "transitions": [
        {
          "status": "success",
          "target": "approved"
        }
      ]
    },
    {
      "name": "approved",
      "status": "approved",
      "data": {},
      "transitions": []
    }
  ]
}
