{
  "id": "uk-bnpl-credit-check-algoan-local",
  "version": 2,
  "name": "UK BNPL credit check (Algoan, local walkthrough copy)",
  "initial": "applicant",
  "webhook": {
    "notify": {
      "path": "notify"
    }
  },
  "steps": [
    {
      "name": "applicant",
      "type": "contact-details",
      "config": {
        "email": "required",
        "phoneNumber": "omitted"
      },
      "include": [
        {
          "type": "form",
          "config": {
            "fields": {
              "firstName": {
                "type": "text",
                "required": true,
                "validation": {
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "lastName": {
                "type": "text",
                "required": true,
                "validation": {
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            },
            "canonical": {
              "firstName": "firstName",
              "lastName": "lastName"
            }
          }
        }
      ],
      "edges": {
        "success": "credit_consent"
      }
    },
    {
      "name": "credit_consent",
      "type": "consents",
      "config": {
        "consents": [
          {
            "key": "openBankingCreditCheck",
            "version": "2026-10",
            "acknowledgement": "consent"
          }
        ]
      },
      "edges": {
        "success": "bank_selection"
      }
    },
    {
      "name": "bank_selection",
      "type": "form",
      "config": {
        "fields": {
          "bankId": {
            "type": "text",
            "required": true,
            "clientVisible": true,
            "validation": {
              "pattern": "^[a-z0-9_]+$",
              "maxLength": 40
            }
          },
          "bankName": {
            "type": "text",
            "required": true,
            "clientVisible": true,
            "validation": {
              "maxLength": 100
            }
          }
        }
      },
      "edges": {
        "success": "bank_connection"
      }
    },
    {
      "name": "bank_connection",
      "type": "form",
      "config": {
        "fields": {
          "bankConnectionReference": {
            "type": "text",
            "required": true,
            "validation": {
              "pattern": "^[A-Za-z0-9-]{8,64}$"
            }
          },
          "bankConnectionMethod": {
            "type": "text",
            "required": true,
            "validation": {
              "oneOf": ["qr", "device"]
            }
          },
          "bankProfile": {
            "type": "text",
            "required": true,
            "clientVisible": true,
            "validation": {
              "oneOf": ["high", "medium", "low", "test"]
            }
          }
        }
      },
      "edges": {
        "success": "account_selection"
      }
    },
    {
      "name": "account_selection",
      "type": "form",
      "config": {
        "fields": {
          "selectedAccounts": {
            "type": "array",
            "required": true,
            "clientVisible": true,
            "items": {
              "type": "text",
              "validation": {
                "pattern": "^account-[0-9]{2}$"
              }
            },
            "validation": {
              "minItems": 1,
              "maxItems": 10
            }
          }
        }
      },
      "edges": {
        "success": "bank_access_consent"
      }
    },
    {
      "name": "bank_access_consent",
      "type": "consents",
      "config": {
        "consents": [
          {
            "key": "bankDataAccess",
            "version": "2026-10",
            "acknowledgement": "consent"
          }
        ]
      },
      "edges": {
        "success": "credit_check"
      }
    },
    {
      "name": "credit_check",
      "type": "credit-assessment",
      "config": {
        "connector": {
          "id": "algoan_credit"
        },
        "products": ["creditScore", "paymentScore", "insights"],
        "bands": {
          "approveFrom": 700,
          "reviewFrom": 400
        },
        "maxAttempts": 3,
        "report": "full"
      },
      "edges": {
        "approved": "approved",
        "review": "manual_review",
        "declined": "declined",
        "retry": "account_selection"
      }
    },
    {
      "name": "manual_review",
      "type": "manual-review",
      "edges": {
        "approve": "approved",
        "reject": "declined"
      }
    },
    {
      "name": "approved",
      "type": "terminal",
      "config": {
        "outcome": "approved"
      }
    },
    {
      "name": "declined",
      "type": "terminal",
      "config": {
        "outcome": "rejected"
      }
    }
  ]
}
