{
  "id": "ksa-bnpl-lean-algoan-local",
  "version": 1,
  "name": "KSA BNPL credit check (Lean + Algoan, local walkthrough copy)",
  "initial": "applicant",
  "webhook": {
    "notify": {
      "path": "notify"
    }
  },
  "steps": [
    {
      "name": "applicant",
      "type": "contact-details",
      "config": {
        "email": "required",
        "phoneNumber": "omitted"
      },
      "include": [
        {
          "type": "form",
          "config": {
            "fields": {
              "firstName": {
                "type": "text",
                "required": true,
                "validation": {
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "lastName": {
                "type": "text",
                "required": true,
                "validation": {
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            },
            "canonical": {
              "firstName": "firstName",
              "lastName": "lastName"
            }
          }
        }
      ],
      "edges": {
        "success": "credit_consent"
      }
    },
    {
      "name": "credit_consent",
      "type": "consents",
      "config": {
        "consents": [
          {
            "key": "openBankingCreditCheck",
            "version": "2026-10",
            "acknowledgement": "consent"
          }
        ]
      },
      "edges": {
        "success": "bank_connect"
      }
    },
    {
      "name": "bank_connect",
      "type": "connector-call",
      "config": {
        "fields": {
          "leanCustomerId": {
            "type": "text",
            "required": false
          },
          "bankConnectOutcome": {
            "type": "text",
            "required": false,
            "clientVisible": true,
            "validation": {
              "oneOf": ["connected", "data_unavailable", "not_connected"]
            }
          },
          "salaryMonthlyAverage": {
            "type": "number",
            "required": false,
            "clientVisible": true
          },
          "salaryMonthsDetected": {
            "type": "number",
            "required": false,
            "clientVisible": true
          },
          "nonSalaryMonthlyAverage": {
            "type": "number",
            "required": false,
            "clientVisible": true
          },
          "salaryConsistent": {
            "type": "boolean",
            "required": false,
            "clientVisible": true
          },
          "salaryThresholdMet": {
            "type": "boolean",
            "required": false,
            "clientVisible": true
          },
          "employerName": {
            "type": "text",
            "required": false,
            "clientVisible": true
          },
          "bankDataDocument": {
            "type": "file",
            "required": true,
            "when": {
              "field": "bankConnectOutcome",
              "equals": "connected"
            },
            "validation": {
              "contentTypes": ["application/json"],
              "maxSizeBytes": 1048576
            }
          },
          "bankAccounts": {
            "type": "json",
            "required": false,
            "clientVisible": true
          }
        },
        "connectors": [
          {
            "name": "lean_bank_data",
            "id": "lean_bank_data",
            "type": "credit",
            "async": true,
            "order": 1,
            "fieldMapping": {},
            "optionalFieldMapping": {
              "leanCustomerId": "leanCustomerId"
            },
            "config": {
              "minMonthlySalary": 4000,
              "exportField": "bankDataDocument"
            }
          }
        ]
      },
      "edges": {
        "success": "bank_data_gate"
      }
    },
    {
      "name": "bank_data_gate",
      "type": "decision",
      "config": {
        "branches": [
          {
            "port": "connected",
            "when": {
              "field": "bankConnectOutcome",
              "equals": "connected"
            }
          },
          {
            "port": "unavailable",
            "when": {
              "not": {
                "field": "bankConnectOutcome",
                "equals": "connected"
              }
            }
          }
        ]
      },
      "edges": {
        "connected": "account_selection",
        "unavailable": "manual_review"
      }
    },
    {
      "name": "account_selection",
      "type": "form",
      "config": {
        "fields": {
          "selectedAccounts": {
            "type": "array",
            "required": true,
            "clientVisible": true,
            "items": {
              "type": "text",
              "validation": {
                "pattern": "^account-[0-9]{2}$"
              }
            },
            "validation": {
              "minItems": 1,
              "maxItems": 10
            }
          }
        }
      },
      "edges": {
        "success": "bank_access_consent"
      }
    },
    {
      "name": "bank_access_consent",
      "type": "consents",
      "config": {
        "consents": [
          {
            "key": "bankDataAccess",
            "version": "2026-10",
            "acknowledgement": "consent"
          }
        ]
      },
      "edges": {
        "success": "credit_check"
      }
    },
    {
      "name": "credit_check",
      "type": "credit-assessment",
      "config": {
        "connector": {
          "id": "algoan_credit"
        },
        "bankDataFrom": "bankDataDocument",
        "accountSelection": "selectedAccounts",
        "products": ["creditScore", "paymentScore", "insights"],
        "bands": {
          "approveFrom": 700,
          "reviewFrom": 400
        },
        "maxAttempts": 3,
        "report": "full"
      },
      "edges": {
        "approved": "approved",
        "review": "manual_review",
        "declined": "declined",
        "retry": "account_selection"
      }
    },
    {
      "name": "manual_review",
      "type": "manual-review",
      "edges": {
        "approve": "approved",
        "reject": "declined"
      }
    },
    {
      "name": "approved",
      "type": "terminal",
      "config": {
        "outcome": "approved"
      }
    },
    {
      "name": "declined",
      "type": "terminal",
      "config": {
        "outcome": "rejected"
      }
    }
  ]
}
