{
  "enabledPlugins": {
    "tsh-product-testing@tsh-agentic-collections": true,
    "tsh-core@tsh-agentic-collections": true,
    "tsh-product-engineering@tsh-agentic-collections": true,
    "tsh-stack-frontend@tsh-agentic-collections": true,
    "tsh-stack-nodejs@tsh-agentic-collections": true
  },
  "extraKnownMarketplaces": {
    "tsh-agentic-collections": {
      "source": {
        "source": "github",
        "repo": "TheSoftwareHouse/agentic-collections"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/skill-evals-reminder.cjs\" post-tool-use",
            "timeout": 10,
            "statusMessage": "Checking whether a skill changed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/skill-evals-reminder.cjs\" stop",
            "timeout": 10,
            "statusMessage": "Checking the skills against their golden sets"
          }
        ]
      }
    ]
  }
}
