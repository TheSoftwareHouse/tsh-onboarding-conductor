# ==========================================
# Onboarding Orchestrator Environment Config
# ==========================================

# --- Engine Core ---
# MODE controls direct (non-Compose) engine starts only; Docker Compose
# pins the engine service to MODE=api-only and the engine-worker service to
# MODE=worker-only to prevent duplicate polling or migration execution.
MODE=all
PORT=3000
# ENGINE_PORT remaps only the host-side port Docker Compose publishes for the
# engine (default 3000); change it if 3000 is already taken on your machine,
# for example ENGINE_PORT=3001. This is distinct from PORT above, which is
# the engine container's application listener and does not change when you
# override ENGINE_PORT. Direct host/browser access follows ENGINE_PORT, for
# example http://localhost:3001.
ENGINE_PORT=3000
ADMIN_PANEL_ORIGIN=http://localhost:5173
NODE_ENV=development
# Workflow sources. Built-in and fixture workflows ship inside the engine package at fixed
# paths and are not configurable. Fixtures are development/test only and are refused when
# NODE_ENV=production. WORKFLOWS_DIR is your own directory, normally a mounted volume.
FIXTURE_WORKFLOWS_ENABLED=true
# WORKFLOWS_DIR=/absolute/path/to/your-workflows
# Registers the sandbox connectors (the mock_* types), which fake their providers.
# Required by most of the fixture workflows. Refused when NODE_ENV=production.
SANDBOX_CONNECTORS_ENABLED=true

# --- Runtime Dependencies ---
# POSTGRES_PORT remaps only the host-side port Docker Compose publishes for
# Postgres (default 5432); change it if 5432 is already taken on your machine.
# The engine container always reaches Postgres at postgres:5432 regardless of
# this value. DATABASE_URL below is for host/direct (non-Compose) access via
# localhost, so if you change POSTGRES_PORT, update the port in DATABASE_URL
# to match.
POSTGRES_PORT=5432
DATABASE_URL=postgres://orchestrator:orchestrator_pass@localhost:5432/orchestrator?sslmode=disable

# REDIS_PORT remaps only the host-side port Docker Compose publishes for
# Redis (default 6379); change it if 6379 is already taken on your machine.
# The engine container always reaches Redis at redis:6379 regardless of this
# value. REDIS_URL below is for host/direct (non-Compose) access via
# localhost, so if you change REDIS_PORT, update the port in REDIS_URL to
# match.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Twilio Verify ---
# Configure Twilio Verify for SMS-only verification flows.
# TWILIO_VERIFY_SERVICE_SID must start with VA and comes from Twilio Console -> Verify -> Services.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA0000000000000000000000000000000
TWILIO_VERIFY_TIMEOUT_MS=10000

# --- SendGrid ---
# Configure SendGrid for transactional email delivery.
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM=no-reply@example.com

# --- Optional Client Webhook Delivery ---
# Leave empty to disable client webhook event creation.
# Must be an absolute HTTP(S) URL without credentials or fragments.
# In production HTTPS is required; in development/test HTTP is allowed only for loopback hosts.
CLIENT_WEBHOOK_BASE_URL=
# Bounded request timeout for client webhook delivery attempts in milliseconds.
CLIENT_WEBHOOK_TIMEOUT_MS=5000
# HMAC-SHA256 keys used to sign outbound client webhooks, as a JSON object of
# key id to secret. Required whenever CLIENT_WEBHOOK_BASE_URL is set; each secret
# must be at least 32 characters. Every configured key signs every delivery, so a
# rotation is: add the new key, let clients accept both, then drop the old one.
# Example: {"2026-08":"<32+ char secret>","2026-09":"<32+ char secret>"}
CLIENT_WEBHOOK_SIGNING_SECRETS={}

# --- Generic HTTP Connector ---
# Default bounded request timeout for http_request connector calls in
# milliseconds; a connector declaration may override it with request.timeoutMs.
HTTP_CONNECTOR_TIMEOUT_MS=5000
# Values that workflow JSON references as {{secrets.<alias>.<key>}}, as a JSON
# object of aliases to string maps. Every reference is checked at workflow-load
# time, so a missing entry fails startup.
HTTP_CONNECTOR_SECRETS={}

# --- Webhook Outbox Queue ---
# These queue settings apply to both MODE=worker-only and MODE=all. The queue
# name is shared by the API and worker services, and the concurrency limit
# bounds the number of in-flight BullMQ workers.
WEBHOOK_OUTBOX_QUEUE_NAME=webhook-outbox
WEBHOOK_OUTBOX_QUEUE_CONCURRENCY=4

# --- Webhook Outbox Retry Worker ---
# These settings apply to both MODE=worker-only and MODE=all. They control
# how often the worker reconciles due webhook deliveries, how many candidates
# it considers per poll, and how long a SENDING row is allowed to remain
# claimed before its lease is considered stale and the row is terminalized as
# ERROR. WEBHOOK_OUTBOX_WORKER_LEASE_MS must be at least
# CLIENT_WEBHOOK_TIMEOUT_MS + 5000 ms.
WEBHOOK_OUTBOX_WORKER_POLL_INTERVAL_MS=1000
WEBHOOK_OUTBOX_WORKER_BATCH_SIZE=25
WEBHOOK_OUTBOX_WORKER_LEASE_MS=60000

# --- MinIO (S3-compatible) ---
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=orchestrator-files
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PORT remaps only the host-side port Docker Compose publishes for
# the MinIO API (default 9000); change it if 9000 is already taken on your
# machine, for example STORAGE_S3_PORT=9002. The engine container always
# reaches MinIO at http://minio:9000 regardless of this value.
# STORAGE_S3_ENDPOINT below is for host/direct (non-Compose) access via
# localhost, so if you change STORAGE_S3_PORT, update the port in
# STORAGE_S3_ENDPOINT to match.
STORAGE_S3_PORT=9000
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin

# MINIO_CONSOLE_PORT remaps only the host-side port Docker Compose publishes
# for the MinIO web console (default 9001); change it if 9001 is already
# taken on your machine, for example MINIO_CONSOLE_PORT=9003. The console is
# a direct-host-only convenience UI; it has no Compose-network consumer, so
# access it at http://localhost:<MINIO_CONSOLE_PORT> after changing this
# value.
MINIO_CONSOLE_PORT=9001

# --- Admin panel ---
VITE_ENGINE_API_BASE_URL=http://localhost:3000

# --- MailHog (local/dev/CI SMTP sink) ---
# MAILHOG_HTTP_PORT remaps only the host-side port Docker Compose publishes
# for the MailHog HTTP inspection UI/API (default 8025); change it if 8025 is
# already taken on your machine, for example MAILHOG_HTTP_PORT=8026. Engine
# containers always reach MailHog for SMTP delivery at mailhog:1025
# regardless of this value; SMTP is never published to the host.
MAILHOG_HTTP_PORT=8025
