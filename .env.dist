# ==========================================
# Onboarding Orchestrator Environment Config
# ==========================================

# --- Engine Core ---
# MODE controls direct (non-Compose) engine starts only; Docker Compose
# pins the engine service to MODE=api-only and the engine-worker service to
# MODE=worker-only to prevent duplicate polling or migration execution.
MODE=all
PORT=3000
# ENGINE_PORT remaps only the host-side port Docker Compose publishes for the
# engine (default 3000); change it if 3000 is already taken on your machine,
# for example ENGINE_PORT=3001. This is distinct from PORT above, which is
# the engine container's application listener and does not change when you
# override ENGINE_PORT. Direct host/browser access follows ENGINE_PORT, for
# example http://localhost:3001.
ENGINE_PORT=3000
ADMIN_PANEL_ORIGIN=http://localhost:5173
NODE_ENV=development

# Workflows live in ./workflows, split into three scopes: "built-in/",
# "fixtures/" and "users/". built-in and fixtures ship with the application and
# are not configurable; fixtures are skipped when NODE_ENV=production. Point
# WORKFLOWS_USERS_DIR at your own directory to supply workflows under the
# "users/" scope; leave it unset to use ./workflows/users.
# WORKFLOWS_USERS_DIR=./workflows/users

# Email templates live in ./email-templates, split into three scopes that
# connectors address with a prefix: "built-in/", "fixtures/" and "users/".
# built-in and fixtures ship with the application and are not configurable.
# Point EMAIL_TEMPLATES_USERS_DIR at your own directory to supply templates
# under the "users/" scope; leave it unset to use ./email-templates/users.
# EMAIL_TEMPLATES_USERS_DIR=./email-templates/users

# --- Runtime Dependencies ---
# POSTGRES_PORT remaps only the host-side port Docker Compose publishes for
# Postgres (default 5432); change it if 5432 is already taken on your machine.
# The engine container always reaches Postgres at postgres:5432 regardless of
# this value. DATABASE_URL below is for host/direct (non-Compose) access via
# localhost, so if you change POSTGRES_PORT, update the port in DATABASE_URL
# to match.
POSTGRES_PORT=5432
DATABASE_URL=postgres://orchestrator:orchestrator_pass@localhost:5432/orchestrator?sslmode=disable

# REDIS_PORT remaps only the host-side port Docker Compose publishes for
# Redis (default 6379); change it if 6379 is already taken on your machine.
# The engine container always reaches Redis at redis:6379 regardless of this
# value. REDIS_URL below is for host/direct (non-Compose) access via
# localhost, so if you change REDIS_PORT, update the port in REDIS_URL to
# match.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Connector settings (admin panel) ---
# Secret connector settings an operator saves in the admin panel are encrypted with this key
# (AES-256-GCM) before they are written to the connector_settings table. It must be 32 bytes
# encoded as base64: `openssl rand -base64 32`.
# Without it the panel still edits non-secret settings and refuses to store a secret, rather
# than writing a provider credential to the database in the clear.
# Rotating it makes every secret already stored unreadable; re-enter them in the panel.
# The value below is a checked-in development key, so the engine refuses to start with it when
# NODE_ENV=production. Generate your own for any real deployment: `openssl rand -base64 32`.
CONNECTOR_SETTINGS_ENCRYPTION_KEY=1DwjTuFlMzzSboL1MQPXGw4QUYMWhC6vIZut2B+/RDk=

# --- Twilio Verify ---
# Configure Twilio Verify for SMS-only verification flows.
# All four provider credentials below are optional: an operator can set them in the admin
# panel instead, and a connector reports itself unavailable when neither source supplies one.
# TWILIO_VERIFY_SERVICE_SID must start with VA and comes from Twilio Console -> Verify -> Services.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA0000000000000000000000000000000
TWILIO_VERIFY_TIMEOUT_MS=10000

# --- SendGrid ---
# Configure SendGrid for transactional email delivery.
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM=no-reply@example.com

# --- Optional Client Webhook Delivery ---
# Leave empty to disable client webhook event creation.
# Must be an absolute HTTP(S) URL without credentials or fragments.
# In production HTTPS is required; in development/test HTTP is allowed only for loopback hosts.
CLIENT_WEBHOOK_BASE_URL=
# Bounded request timeout for client webhook delivery attempts in milliseconds.
CLIENT_WEBHOOK_TIMEOUT_MS=5000

# --- Connector Mocks ---
# Which fixture stands in for which connector during tests, as comma-separated
# <connector type>:<mock connector type> pairs. Declarations of the first type are then
# served by the second, so an e2e run needs no workflow change and no third-party
# account. Available mocks: mock_phone_verification, mock_email_verification,
# mock_email_delivery.
#
# Only a NODE_ENV=test run applies these pairs; every other environment, development
# included, reads them and ignores them, logging that it did. Connectors with a local
# sink need no entry: smtp talks to MailHog, http_request to a server the test starts.
CONNECTOR_MOCKS=twilio_verify:mock_phone_verification,sendgrid_email:mock_email_delivery

# --- Generic HTTP Connector ---
# Default bounded request timeout for http_request connector calls in
# milliseconds; a connector declaration may override it with request.timeoutMs.
HTTP_CONNECTOR_TIMEOUT_MS=5000
# Values that workflow JSON references as {{secrets.<alias>.<key>}}, as a JSON
# object of aliases to string maps. Every reference is checked at workflow-load
# time, so a missing entry fails startup.
HTTP_CONNECTOR_SECRETS={}

# --- Inbound Connector Callback Signatures ---
# HMAC signing secrets for provider callbacks hitting
# /v1/webhooks/<connectorType>/callback, as a JSON object keyed by connector
# type. A value is one secret or a list of secrets; a list lets both the old and
# the new secret verify during a provider-side rotation window. A signed
# connector with no entry here rejects every callback with HTTP 401.
# See packages/engine/docs/connector-callback-signatures.md
CONNECTOR_CALLBACK_SIGNING_SECRETS={}
# Connector types whose provider does not sign callbacks at all, as a
# comma-separated list. In production an unsigned connector's callbacks are
# accepted only if its type is listed here; outside production unsigned
# connectors are accepted without listing. Listing a connector means accepting
# unauthenticated requests on a guessable URL, so put a network or source-IP
# allowlist in front of the callback route as well.
CONNECTOR_CALLBACK_UNSIGNED_TYPES=

# --- Webhook Outbox Queue ---
# These queue settings apply to both MODE=worker-only and MODE=all. The queue
# name is shared by the API and worker services, and the concurrency limit
# bounds the number of in-flight BullMQ workers.
WEBHOOK_OUTBOX_QUEUE_NAME=webhook-outbox
WEBHOOK_OUTBOX_QUEUE_CONCURRENCY=4

# --- Webhook Outbox Retry Worker ---
# These settings apply to both MODE=worker-only and MODE=all. They control
# how often the worker reconciles due webhook deliveries, how many candidates
# it considers per poll, and how long a SENDING row is allowed to remain
# claimed before its lease is considered stale and the row is terminalized as
# ERROR. WEBHOOK_OUTBOX_WORKER_LEASE_MS must be at least
# CLIENT_WEBHOOK_TIMEOUT_MS + 5000 ms.
WEBHOOK_OUTBOX_WORKER_POLL_INTERVAL_MS=1000
WEBHOOK_OUTBOX_WORKER_BATCH_SIZE=25
WEBHOOK_OUTBOX_WORKER_LEASE_MS=60000

# --- MinIO (S3-compatible) ---
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=orchestrator-files
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PORT remaps only the host-side port Docker Compose publishes for
# the MinIO API (default 9000); change it if 9000 is already taken on your
# machine, for example STORAGE_S3_PORT=9002. The engine container always
# reaches MinIO at http://minio:9000 regardless of this value.
# STORAGE_S3_ENDPOINT below is for host/direct (non-Compose) access via
# localhost, so if you change STORAGE_S3_PORT, update the port in
# STORAGE_S3_ENDPOINT to match.
STORAGE_S3_PORT=9000
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin

# MINIO_CONSOLE_PORT remaps only the host-side port Docker Compose publishes
# for the MinIO web console (default 9001); change it if 9001 is already
# taken on your machine, for example MINIO_CONSOLE_PORT=9003. The console is
# a direct-host-only convenience UI; it has no Compose-network consumer, so
# access it at http://localhost:<MINIO_CONSOLE_PORT> after changing this
# value.
MINIO_CONSOLE_PORT=9001

# --- Admin panel ---
VITE_ENGINE_API_BASE_URL=http://localhost:3000

# --- Admin panel SSO ---
# VITE_SSO_PROVIDER picks which identity provider the panel signs the operator in against.
# 'azure' (Microsoft Entra ID) is the only one implemented, and is used when this is unset; any
# other value stops the panel with a message naming the supported ones rather than quietly
# falling back to Entra. Switching later means setting this and the provider's own variables,
# together with ADMIN_SSO_PROVIDER on the engine so both sides trust the same directory.
VITE_SSO_PROVIDER=azure
#
# --- Admin panel Azure SSO ---
# The admin panel signs the operator in against Microsoft Entra ID before it renders. This is a
# browser (public client) authorization code flow with PKCE, so no client secret or certificate
# belongs here or anywhere else in the panel; every value below is a public identifier.
#
# Sign-in is enabled whenever VITE_AUTH_ENABLED is unset, so a deployed build is gated by
# default. It ships as false here only so a fresh clone runs without an Entra tenant, and the
# admin-panel Playwright suite sets it to false for its own run. Never deploy with it false.
VITE_AUTH_ENABLED=false
#
# Required whenever sign-in is enabled; the panel refuses to start without them and names
# whichever one is missing. Take them from the panel's SPA app registration.
#VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#
# Also required when sign-in is enabled. This is the scope exposed by the engine's own app
# registration ("Expose an API" -> Add a scope). The access token the panel receives for it
# travels to the engine as a bearer credential on every admin request, so it must correspond to
# AZURE_API_AUDIENCE below.
#VITE_AZURE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/Onboardings.Read
#
# Optional; defaults to the origin the panel is served from, which is what an SPA registration
# normally uses. Whatever value applies must be registered on the app registration exactly.
#VITE_AZURE_REDIRECT_URI=http://localhost:5173/

# --- Engine admin endpoint authentication ---
# ADMIN_SSO_PROVIDER picks which identity provider issues the access tokens the engine accepts,
# and therefore which of the provider settings below are required. It mirrors the panel's
# VITE_SSO_PROVIDER and must name the same provider, or the panel will hand the engine tokens it
# refuses. 'azure' (Microsoft Entra ID) is the only one implemented and is used when unset; any
# other value stops the engine at startup.
ADMIN_SSO_PROVIDER=azure
#
# ADMIN_AUTH_ENABLED makes the engine verify a Microsoft Entra ID access token on its two admin
# read endpoints (GET /v1/onboardings and GET /v1/admin/audit). It is what actually protects
# onboarding data; the panel's sign-in gate only decides whether the UI renders. It defaults to
# true when unset, and is false here only so a fresh clone starts without an Entra tenant.
#
# This file is on the engine's env search path, so a deployment started with no explicit
# environment would otherwise inherit the line below. Setting it false is refused outright when
# NODE_ENV=production: the engine will not start rather than serve admin data unguarded.
ADMIN_AUTH_ENABLED=false
#
# Both are required when ADMIN_AUTH_ENABLED is true, and the engine refuses to start without
# them. AZURE_TENANT_ID must be a concrete directory (tenant) id, not "common" or
# "organizations", because the engine pins the accepted token issuer to it.
#
# AZURE_API_AUDIENCE is the audience the tokens carry. In a v2.0 access token that is the client
# id (a GUID) of the app registration exposing VITE_AZURE_API_SCOPE above, not the api:// URI.
# That registration's manifest must set "accessTokenAcceptedVersion": 2, or Entra issues v1.0
# tokens whose issuer the engine does not accept. See docs/IMPLEMENTATION.md section 11.
#AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#AZURE_API_AUDIENCE=00000000-0000-0000-0000-000000000000
#
# ADMIN_REQUIRED_ROLES is the comma-separated allowlist of Entra app roles that may read admin
# data. A verified token whose "roles" claim holds none of them is rejected with 403, not 401,
# because signing in again cannot help. Use each role's portal "Value", not its display name;
# the comparison ignores case. Entra only emits the claim for roles the user is assigned, so an
# unassigned account is refused even with a perfectly valid token.
ADMIN_REQUIRED_ROLES=admin

# --- MailHog (local/dev/CI SMTP sink) ---
# MAILHOG_HTTP_PORT remaps only the host-side port Docker Compose publishes
# for the MailHog HTTP inspection UI/API (default 8025); change it if 8025 is
# already taken on your machine, for example MAILHOG_HTTP_PORT=8026. Engine
# containers always reach MailHog for SMTP delivery at mailhog:1025
# regardless of this value; SMTP is never published to the host.
MAILHOG_HTTP_PORT=8025
#
# The SMTP connector itself is provider-agnostic: point SMTP_HOST/SMTP_PORT at
# any SMTP server. Compose wires it to MailHog and sets SMTP_ALLOW_INSECURE=true,
# which is the only way to run with SMTP_SECURE=false and SMTP_STARTTLS=false.
# Never set SMTP_ALLOW_INSECURE outside local development or CI.
